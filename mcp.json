{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222",
        "--caps=vision,pdf"
      ]
    },
    "js-reverse": {
      "command": "npx",
      "args": [
        "-y",
        "js-reverse-mcp@4.0.5",
        "--browserUrl",
        "http://127.0.0.1:9222",
        "--allowedRoots",
        "/Users/lb/src-hunt"
      ]
    },
    "fofa": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/lb/.pi/agent/skills/src-hunting/mcp/fofa_MCP",
        "python",
        "fofa.py"
      ]
    }
  }
}
